{
  "expo": {
    "name": "reset-sos",
    "slug": "reset-sos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.atypikali.resetsos"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#060084",
          "sounds": []
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "RESET SOS",
      "shortName": "RESET SOS",
      "description": "Régulation émotionnelle sensorielle — Méthode RESET par Atypikali",
      "themeColor": "#060084",
      "backgroundColor": "#060084",
      "output": "single",
      "baseUrl": "/reset-sos"
    }
  }
}
